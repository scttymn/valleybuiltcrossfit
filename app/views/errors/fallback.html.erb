<%# Last resort: shown only when the themed error page itself can't be built
    (the database is unreachable, say). Nothing here touches the app — no
    theme, no fonts, no images — so it renders when nothing else will. It
    lives outside public/ so no URL serves it as a 200. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Something broke — Valley Built CrossFit</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <style>
      body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
             background: #14140f; color: #f4f1e6; font-family: system-ui, sans-serif; text-align: center; padding: 24px; }
      h1 { font-size: 28px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; }
      p { margin: 0 0 20px; line-height: 1.6; color: #c9c5b4; }
      a { color: #f4f1e6; }
    </style>
  </head>
  <body>
    <div>
      <h1>Something broke</h1>
      <p>That's a problem on our end. Try again in a minute.</p>
      <p><a href="/">Valley Built CrossFit</a></p>
    </div>
  </body>
</html>
