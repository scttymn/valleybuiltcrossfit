<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · " : "" %>Valley Built Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Oswald:wght@500;600&display=swap" rel="stylesheet">
    <style><%= Site.instance.theme.to_css %></style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <% if authenticated? %>
      <aside class="admin-nav">
        <%= link_to admin_root_path, class: "admin-nav__brand" do %>
          <%= image_tag "logo-valley-built-horizontal.png", alt: "Valley Built CrossFit" %>
        <% end %>
        <nav>
          <% [ [ "Dashboard", admin_root_path ], [ "Announcement bar", edit_admin_announcement_path ], [ "Site content", edit_admin_site_path ], [ "Programs", admin_programs_path ],
               [ "Pillars", admin_pillars_path ], [ "Steps", admin_steps_path ], [ "Membership options", admin_membership_options_path ],
               [ "Staff", admin_staff_members_path ], [ "FAQs", admin_faqs_path ], [ "Workouts", admin_workouts_path ],
               [ "Inquiries", admin_leads_path ], [ "Admins", admin_users_path ], [ "Settings", edit_admin_settings_path ] ].each do |label, path| %>
            <%= link_to label, path, class: ("is-active" if current_page?(path) || (path != admin_root_path && request.path.start_with?(path.sub(%r{/edit\z}, "")))) %>
          <% end %>
        </nav>
        <div class="admin-nav__foot">
          <%= link_to "View site ↗", root_path, target: "_blank" %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
        </div>
      </aside>
    <% end %>

    <main class="admin-main <%= "admin-main--bare" unless authenticated? %>">
      <% if notice.present? %><div class="flash flash--notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash flash--alert" role="alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
