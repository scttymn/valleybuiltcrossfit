<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{yield(:title)} · " : "" %>Valley Built Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <style><%= Site.instance.theme.to_css %></style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="admin">
    <% if authenticated? %>
      <aside class="admin-nav">
        <%= link_to admin_root_path, class: "admin-nav__brand" do %>
          <%= brand_logo %>
        <% end %>
        <nav>
          <% link = ->(label, path) { link_to label, path, class: ("is-active" if admin_nav_current?(path)) } %>
          <%= link.("Dashboard", admin_root_path) %>
          <%= link.("Announcement bar", edit_admin_announcement_path) %>
          <%= render "admin/nav_group", title: "Site content",
                items: Admin::SitesController::SECTIONS.keys.map { [ _1, edit_admin_site_section_path(_1.parameterize) ] } %>
          <% [ [ "Programs", admin_programs_path ], [ "Pillars", admin_pillars_path ], [ "Steps", admin_steps_path ],
               [ "Membership options", admin_membership_options_path ], [ "Staff", admin_staff_members_path ], [ "FAQs", admin_faqs_path ],
               [ "Workouts", admin_workouts_path ], [ "Inquiries", admin_leads_path ], [ "Admins", admin_users_path ] ].each do |label, path| %>
            <%= link.(label, path) %>
          <% end %>
          <%= render "admin/nav_group", title: "Settings", items: [
                [ "Theme", edit_admin_settings_theme_path ], [ "Photos", edit_admin_settings_photos_path ], [ "PushPress", edit_admin_settings_pushpress_path ] ] %>
        </nav>
        <div class="admin-nav__foot">
          <%= link_to "View site ↗", root_path, target: "_blank" %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
        </div>
      </aside>
    <% end %>

    <main class="admin-main <%= "admin-main--bare" unless authenticated? %>">
      <% if notice.present? %><div class="flash flash--notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash flash--alert" role="alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
