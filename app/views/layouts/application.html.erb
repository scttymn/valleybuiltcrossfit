<% theme = @theme || Site.instance.theme %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Valley Built CrossFit — Grain Valley, Missouri" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Coached CrossFit classes for every body in Grain Valley, Missouri." %>">
    <meta name="theme-color" content="<%= theme.background %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="<%= app_icon_path %>" type="image/png" sizes="512x512">
    <link rel="icon" href="<%= themed_favicon_path %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= app_icon_path %>">
    <%# Fonts are served from the site (fonts.css). The faces on screen when
        the page opens are fetched first, so the text never paints in a
        fallback and swaps — which made the hero jump 154px. %>
    <% %w[oswald-latin-70d7df barlow-latin-8d018f barlow-condensed-latin-28c6fc barlow-condensed-latin-b3f569 ibm-plex-mono-latin-a80b2c].each do |font| %>
      <%= preload_link_tag "#{font}.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <% end %>

    <style><%= theme.to_css %></style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="site">
    <%= yield %>
  </body>
</html>
