<section id="visit" class="band">
  <div class="visit">
    <div class="visit__copy">
      <span class="eyebrow">Find us</span>
      <h2><%= site.visit_title %><% if site.visit_script.present? %><br><span><%= site.visit_script %></span><% end %></h2>
      <div class="visit__facts">
        <div>
          <h4>Address</h4>
          <%= site.address_line1 %><% if site.address_line2.present? %>, <%= site.address_line2 %><% end %><br><%= site.city_state_zip %>
        </div>
        <div>
          <h4>Get in touch</h4>
          <a href="<%= site.phone_href %>"><%= site.phone %></a><br><%= mail_to site.email %>
        </div>
      </div>
      <div class="visit__actions">
        <a href="#get-options" class="btn btn--primary" data-action="click->prefill#apply" data-prefill-interest-param="<%= Lead::QUESTION %>">Contact us</a>
        <details class="directions" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
          <summary class="btn btn--ghost">Get directions</summary>
          <div class="directions__menu">
            <% site.directions_links.each do |app, url| %>
              <a href="<%= url %>" target="_blank" rel="noopener"><%= image_tag map_app_icon(app), alt: "", class: "directions__icon" %><%= app %></a>
            <% end %>
          </div>
        </details>
      </div>
    </div>
    <% if site.map_location? %>
      <div class="visit__map" role="region" aria-label="Map to <%= site.full_address %>"
           data-controller="map" data-map-latitude-value="<%= site.map_latitude %>" data-map-longitude-value="<%= site.map_longitude %>"></div>
    <% end %>
  </div>
</section>
