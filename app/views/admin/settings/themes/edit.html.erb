<% content_for :title, "Theme" %>
<header class="admin-head">
  <h1>Theme</h1>
</header>

<%= form_with model: @site, url: admin_settings_theme_path, method: :patch, class: "form" do |form| %>
  <%= render "admin/resources/errors", record: @site %>

  <fieldset class="form__section" data-controller="theme-preview" data-theme-preview-url-value="<%= preview_admin_settings_theme_path %>" data-action="message@window->theme-preview#suggested">
    <legend>Colors</legend>
    <p class="field__hint">
      Pick three colors and every other shade on the site is worked out from them. The sample updates as you go;
      nothing changes on the site until you save.
    </p>

    <div class="theme-editor">
      <div class="theme-editor__fields">
        <% { background: "Background", text: "Text", accent: "Accent", danger: "Danger" }.each do |part, label| %>
          <% column = Site::THEME_COLORS[part] %>
          <div class="field">
            <%= form.label column, label %>
            <div class="theme-editor__pick">
              <input type="color" value="<%= @site.theme.public_send(part) %>" aria-label="<%= label %> color"
                     data-theme-preview-target="swatch" data-part="<%= part %>" data-action="input->theme-preview#picked">
              <%= form.text_field column, value: @site.public_send(column).presence || @site.theme.public_send(part),
                    maxlength: 7, spellcheck: false, autocomplete: "off",
                    data: { theme_preview_target: "hex", part:, action: "input->theme-preview#typed" } %>
            </div>
          </div>
        <% end %>
        <p class="field__hint">The defaults are the logo&rsquo;s colors: black, cream <code><%= Theme::DEFAULTS[:text] %></code> and green <code><%= Theme::DEFAULTS[:accent] %></code>. Danger colors delete links and error messages.</p>

        <div class="field">
          <%= form.label :theme_border_width, "Border width" %>
          <%= form.select :theme_border_width, Theme::BORDER_WIDTHS.map { [ "#{_1}px", _1 ] }, { selected: @site.theme.border_width },
                data: { theme_preview_target: "setting", part: "border_width", action: "change->theme-preview#refresh" } %>
          <p class="field__hint">Every border on the site: buttons, the schedule, cards, class slots. Default <%= Theme::DEFAULT_BORDER_WIDTH %>px.</p>
        </div>
      </div>

      <iframe class="theme-editor__sample" title="Color sample" src="<%= preview_admin_settings_theme_path %>"
              data-theme-preview-target="frame"></iframe>
    </div>

    <div class="theme-editor__status">
      <% if @site.theme_customized? %>
        <%= form.button "Reset colors to defaults", name: "reset_colors", value: "1", class: "button button--ghost",
              data: { turbo_confirm: "Put the site back to the default colors?" } %>
      <% else %>
        <p class="field__hint">Using the default colors.</p>
      <% end %>
    </div>
  </fieldset>

  <div class="form__actions"><%= form.submit "Save", class: "button" %><%= link_to "View site ↗", root_path, target: "_blank" %></div>
<% end %>
