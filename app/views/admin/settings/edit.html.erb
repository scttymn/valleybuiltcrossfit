<% content_for :title, "Settings" %>
<header class="admin-head">
  <h1>Settings</h1>
</header>

<%= form_with model: @site, url: admin_settings_path, method: :patch, class: "form" do |form| %>
  <%= render "admin/resources/errors", record: @site %>

  <fieldset class="form__section" data-controller="theme-preview" data-theme-preview-url-value="<%= theme_preview_admin_settings_path %>" data-action="message@window->theme-preview#suggested">
    <legend>Colors</legend>
    <p class="field__hint">
      Pick three colors and every other shade on the site is worked out from them. The sample updates as you go;
      nothing changes on the site until you save.
    </p>

    <div class="theme-editor">
      <div class="theme-editor__fields">
        <% { background: "Background", text: "Text", accent: "Accent" }.each do |part, label| %>
          <% column = Site::THEME_COLORS[part] %>
          <div class="field">
            <%= form.label column, label %>
            <div class="theme-editor__pick">
              <input type="color" value="<%= @site.theme.public_send(part) %>" aria-label="<%= label %> color"
                     data-theme-preview-target="swatch" data-part="<%= part %>" data-action="input->theme-preview#picked">
              <%= form.text_field column, value: @site.public_send(column).presence || @site.theme.public_send(part),
                    maxlength: 7, spellcheck: false, autocomplete: "off",
                    data: { theme_preview_target: "hex", part:, action: "input->theme-preview#typed" } %>
            </div>
          </div>
        <% end %>
        <p class="field__hint">The accent is the logo green, <code><%= Theme::DEFAULTS[:accent] %></code>, until you change it.</p>
      </div>

      <iframe class="theme-editor__sample" title="Color sample" src="<%= theme_preview_admin_settings_path %>"
              data-theme-preview-target="frame"></iframe>
    </div>

    <div>
      <%= form.button "Reset colors to defaults", name: "reset_colors", value: "1", class: "button button--ghost",
            data: { turbo_confirm: "Put the site back to the default colors?" } %>
    </div>
  </fieldset>

  <fieldset class="form__section">
    <legend>Photos</legend>

    <div class="field">
      <%= form.label :image_quality, "Image quality" %>
      <%= form.number_field :image_quality, in: Site::IMAGE_QUALITY_RANGE, step: 5 %>
      <p class="field__hint">
        Uploaded photos are resized and converted to WebP before visitors see them; the originals are kept untouched.
        80 is the sweet spot &mdash; lower means faster pages, higher means crisper photos.
        Changing this rebuilds each photo the next time it&rsquo;s shown, so the first page load afterwards is a little slower.
      </p>
    </div>
  </fieldset>

  <div class="form__actions"><%= form.submit "Save", class: "button" %><%= link_to "View site ↗", root_path, target: "_blank" %></div>
<% end %>
