<% content_for :title, @section %>
<header class="admin-head">
  <h1><%= @section %></h1>
  <p class="admin-head__note">Text for the home page. Line breaks are kept; simple <code>&lt;a href="…"&gt;</code> links are allowed in longer fields.</p>
</header>

<%= form_with model: @site, url: admin_site_section_path(params[:section]), method: :patch, class: "form" do |form| %>
  <%= render "admin/resources/errors", record: @site %>
  <fieldset class="form__section">
    <% @fields.each do |field| %>
      <%= render "admin/resources/field", form:, field:, record: @site %>
    <% end %>
  </fieldset>
  <div class="form__actions">
    <%= form.submit "Save", class: "button" %>
  </div>
<% end %>
